{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "test",
      "dist"
    ]
  },
  "context": {
    "minute:enableCdn": true,
    "minute:authMode": "magic-link",
    "minute:restrictAlbToCloudFront": true,
    "minute:enableWaf": true,
    "minute:enableSecurityHeaders": true,
    "minute:geoAllowlist": "GB",
    "minute:wafRateLimit": 300,
    "minute:wafRateWindowSec": 60,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "@aws-cdk/aws-rds:lowercaseDbIdentifier": true,
    "@aws-cdk/aws-efs:denyAnonymousAccess": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-events:eventsTargetQueueSameAccount": true,
    "@aws-cdk/aws-secretsmanager:useAttachedSecretResourcePolicyForSecretTargetAttachments": true
  },
  "output": "../cdk.out"
}
